# Скопируйте в .env и измените значение перед развертыванием на сервере
DB_PASSWORD=root
JWT_SECRET=change-me-in-production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Адреса бекенду, доступна з браузера (для WebSocket). Локально — localhost, на сервері — ваш домен/IP з портом 4000
PUBLIC_API_URL=http://localhost:4000
