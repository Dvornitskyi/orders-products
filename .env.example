# Скопіюйте в .env і змініть значення перед розгортанням на сервері
DB_PASSWORD=root
JWT_SECRET=change-me-in-production
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
# Адреса бекенду, доступна з браузера (для WebSocket). Локально — localhost, на сервері — ваш домен/IP з портом 4000
PUBLIC_API_URL=http://localhost:4000
